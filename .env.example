APP_NAME=BigWorldFitness
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# ==========================================
# CONFIGURACIÓN REGIONAL & MONEDA (VENEZUELA)
# ==========================================
APP_TIMEZONE=America/Caracas
APP_LOCALE=es_VE
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_VE

APP_CURRENCY=USD
APP_CURRENCY_SYMBOL="$"
APP_SECONDARY_CURRENCY=VES
APP_SECONDARY_CURRENCY_SYMBOL="Bs."

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# ==========================================
# ROTACIÓN Y RETENCIÓN DIARIA DE LOGS
# ==========================================
LOG_CHANNEL=daily
LOG_STACK=daily
LOG_DAILY_DAYS=30
LOG_LEVEL=debug

# ==========================================
# BASE DE DATOS
# ==========================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=teleredt_gym_prueba
DB_USERNAME=root
DB_PASSWORD=

# ==========================================
# SEGURIDAD AVANZADA DE SESIONES
# ==========================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=false  # Cambiar a true al desplegar con SSL/HTTPS
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log

# ==========================================
# SISTEMA DE ARCHIVOS & MULTIMEDIA
# ==========================================
FILESYSTEM_DISK=public

QUEUE_CONNECTION=database
CACHE_STORE=database

# ==========================================
# REMITENTE INSTITUCIONAL DE CORREO (GMAIL SMTP)
# ==========================================
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD="tu_clave_de_aplicacion"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=""
MAIL_FROM_NAME="${APP_NAME}"

# ==========================================
# INTEGRACIÓN API CNE
# ==========================================
CNE_API_APP_ID=2118
CNE_API_TOKEN=ad3e6e46e42e96adba76c92c23755b54
CNE_API_URL=https://api.cedula.com.ve/api/v1

# ==========================================
# FRONTEND & VITE SYNCHRONIZATION
# ==========================================
VITE_APP_NAME="${APP_NAME}"
VITE_APP_URL="${APP_URL}"